//@version=5
indicator("AI Signal Indicator - Scalping/Swing/Daily Strategy", overlay=true)

// ====================== TIMEFRAME & STRATEGY SELECTION ======================
strategyMode = input.string("AUTO", "Strategy Mode", options=["AUTO", "SCALPING", "SWING", "DAILY"])

// Detect timeframe automatically
currentTimeframe = timeframe.period
isScalping = strategyMode == "AUTO" ? (currentTimeframe == "1" or currentTimeframe == "3" or currentTimeframe == "5" or currentTimeframe == "15") : (strategyMode == "SCALPING")
isSwing = strategyMode == "AUTO" ? (currentTimeframe == "30" or currentTimeframe == "60" or currentTimeframe == "120" or currentTimeframe == "240") : (strategyMode == "SWING")
isDaily = strategyMode == "AUTO" ? (currentTimeframe == "D" or currentTimeframe == "W" or currentTimeframe == "1D") : (strategyMode == "DAILY")

// ====================== MARKET DETECTION ======================
marketInput = input.string("AUTO", "Market Type", options=["AUTO", "CRYPTO", "FOREX", "GOLD", "INDICES", "STOCKS"])

isCrypto = marketInput == "AUTO" ? (syminfo.type == "crypto") : (marketInput == "CRYPTO")
isForex = marketInput == "AUTO" ? (syminfo.type == "forex") : (marketInput == "FOREX")
isGold = marketInput == "AUTO" ? (syminfo.description == "XAUUSD" or syminfo.description == "GOLD") : (marketInput == "GOLD")
isIndices = marketInput == "AUTO" ? (syminfo.type == "index") : (marketInput == "INDICES")
isStocks = marketInput == "AUTO" ? (syminfo.type == "stock") : (marketInput == "STOCKS")

// ====================== STRATEGY-SPECIFIC PARAMETERS ======================

// SCALPING (1-15 min) - Quick entries/exits, tight SL/TP
scalp_SwingLen = input(2, "Scalp Swing Length", minval=1)
scalp_RSI = input(14, "Scalp RSI Length")
scalp_RSIOBThreshold = input(75, "Scalp RSI OB")
scalp_RSIOSThreshold = input(25, "Scalp RSI OS")
scalp_TP_Percent = input(0.3, "Scalp TP %", minval=0.1)
scalp_SL_Percent = input(0.1, "Scalp SL %", minval=0.05)
scalp_ConfidenceMin = input(0.70, "Scalp Min Confidence")

// SWING (30min-4H) - Medium entries/exits, medium SL/TP
swing_SwingLen = input(5, "Swing Length", minval=1)
swing_RSI = input(14, "Swing RSI Length")
swing_RSIOBThreshold = input(70, "Swing RSI OB")
swing_RSIOSThreshold = input(30, "Swing RSI OS")
swing_TP_Percent = input(0.8, "Swing TP %", minval=0.1)
swing_SL_Percent = input(0.3, "Swing SL %", minval=0.1)
swing_ConfidenceMin = input(0.65, "Swing Min Confidence")

// DAILY (Daily+) - Long-term entries/exits, wider SL/TP
daily_SwingLen = input(7, "Daily Swing Length", minval=1)
daily_RSI = input(21, "Daily RSI Length")
daily_RSIOBThreshold = input(70, "Daily RSI OB")
daily_RSIOSThreshold = input(30, "Daily RSI OS")
daily_TP_Percent = input(2.0, "Daily TP %", minval=0.5)
daily_SL_Percent = input(0.8, "Daily SL %", minval=0.2)
daily_ConfidenceMin = input(0.60, "Daily Min Confidence")

// Select parameters based on strategy
swingLength = isScalping ? scalp_SwingLen : (isSwing ? swing_SwingLen : daily_SwingLen)
rsiLength = isScalping ? scalp_RSI : (isSwing ? swing_RSI : daily_RSI)
rsiOverbought = isScalping ? scalp_RSIOBThreshold : (isSwing ? swing_RSIOBThreshold : daily_RSIOBThreshold)
rsiOversold = isScalping ? scalp_RSIOSThreshold : (isSwing ? swing_RSIOSThreshold : daily_RSIOSThreshold)
tp_Percent = isScalping ? scalp_TP_Percent : (isSwing ? swing_TP_Percent : daily_TP_Percent)
sl_Percent = isScalping ? scalp_SL_Percent : (isSwing ? swing_SL_Percent : daily_SL_Percent)
confidenceMin = isScalping ? scalp_ConfidenceMin : (isSwing ? swing_ConfidenceMin : daily_ConfidenceMin)

// Common parameters
stochLength = input(14, "Stochastic Length", minval=1)
stochSmooth = input(3, "Stochastic Smooth", minval=1)
macdFast = input(12, "MACD Fast")
macdSlow = input(26, "MACD Slow")
macdSignal = input(9, "MACD Signal")
fvgSize = input(0.5, "FVG Size %")
atrLength = input(14, "ATR Length")
divergenceLength = input(5, "Divergence Length")

// ====================== CORE CALCULATIONS ======================

// RSI
rsi = ta.rsi(close, rsiLength)
rsiChange = rsi - rsi[1]
rsiMomentum = ta.sma(rsiChange, 5)

// Stochastic
stochK = ta.stoch(close, high, low, stochLength)
stochD = ta.sma(stochK, stochSmooth)
stochMomentum = stochK - stochD

// MACD
[macdLine, macdSignalLine, macdHistogram] = ta.macd(close, macdFast, macdSlow, macdSignal)

// Volume
volSMA = ta.sma(volume, 20)
volRatio = volume / volSMA
volConfirm = volRatio > 1.2

// ATR
atr = ta.atr(atrLength)
atrSMA = ta.sma(atr, 10)
highVol = atr > atrSMA * 1.2

// Price Action
highestHigh = ta.highest(high, swingLength)
lowestLow = ta.lowest(low, swingLength)
priceRange = high - low
avgRange = ta.sma(priceRange, 20)

// Swing Points
swingHigh = high[swingLength] > ta.highest(high[1], swingLength) and high[swingLength] > ta.highest(high[swingLength+1], swingLength)
swingLow = low[swingLength] < ta.lowest(low[1], swingLength) and low[swingLength] < ta.lowest(low[swingLength+1], swingLength)

// Break of Structure
bosUp = close > highestHigh and close[1] <= highestHigh
bosDown = close < lowestLow and close[1] >= lowestLow

// Fair Value Gap
fvgUp = low > high[2] and (high[2] - low) / high[2] * 100 > fvgSize
fvgDown = high < low[2] and (low - high[2]) / low * 100 > fvgSize

// Divergence
bullDivergence = low < low[divergenceLength] and rsi > rsi[divergenceLength] and rsi < rsiOversold
bearDivergence = high > high[divergenceLength] and rsi < rsi[divergenceLength] and rsi > rsiOverbought

// Pin Bars
pinBarUp = (open < close) and (close > open + ((high - low) * 0.75)) and (low < open - ((high - low) * 0.25))
pinBarDown = (open > close) and (close < open - ((high - low) * 0.75)) and (high > open + ((high - low) * 0.25))

// ====================== AI SCORING ======================

// Bullish Trend Score
trendScore = 0.0
trendScore += (close > ta.sma(close, 50) ? 15 : 0)
trendScore += (close > ta.sma(close, 200) ? 15 : 0)
trendScore += (macdLine > macdSignalLine ? 20 : 0)
trendScore += (rsi > 50 ? 15 : 0)
trendScore += (stochK > stochD ? 15 : 0)
trendScore += (volConfirm ? 10 : 0)
trendScore += (highVol ? 10 : 0)

// Momentum Score
momentumScore = 0.0
momentumScore += (rsiMomentum > 0 ? 20 : 0)
momentumScore += (stochMomentum > 0 ? 20 : 0)
momentumScore += (macdHistogram > macdHistogram[1] ? 20 : 0)
momentumScore += math.abs(rsiChange) > 2 ? 20 : 0
momentumScore += (close > close[5] ? 20 : 0)

// Pattern Score (Bullish)
patternScore = 0.0
patternScore += (bosUp ? 25 : 0)
patternScore += (fvgUp ? 25 : 0)
patternScore += (bullDivergence ? 25 : 0)
patternScore += (pinBarUp ? 15 : 0)
patternScore += (swingLow ? 10 : 0)

// Confirmation Score
confirmationScore = 0.0
confirmationScore += (rsi < rsiOversold ? 20 : 0)
confirmationScore += (stochK < 20 ? 20 : 0)
confirmationScore += (volConfirm ? 20 : 0)
confirmationScore += (priceRange > avgRange ? 20 : 0)
confirmationScore += (macdHistogram > 0 ? 20 : 0)

// Bearish Scores
bearTrendScore = 0.0
bearTrendScore += (close < ta.sma(close, 50) ? 15 : 0)
bearTrendScore += (close < ta.sma(close, 200) ? 15 : 0)
bearTrendScore += (macdLine < macdSignalLine ? 20 : 0)
bearTrendScore += (rsi < 50 ? 15 : 0)
bearTrendScore += (stochK < stochD ? 15 : 0)

bearPatternScore = 0.0
bearPatternScore += (bosDown ? 25 : 0)
bearPatternScore += (fvgDown ? 25 : 0)
bearPatternScore += (bearDivergence ? 25 : 0)
bearPatternScore += (pinBarDown ? 15 : 0)
bearPatternScore += (swingHigh ? 10 : 0)

bearConfirmationScore = 0.0
bearConfirmationScore += (rsi > rsiOverbought ? 20 : 0)
bearConfirmationScore += (stochK > 80 ? 20 : 0)
bearConfirmationScore += (volConfirm ? 20 : 0)
bearConfirmationScore += (macdHistogram < 0 ? 20 : 0)

// AI Confidence
aiConfidenceBuy = (patternScore + confirmationScore + momentumScore) / 300
aiConfidenceSell = (bearPatternScore + bearConfirmationScore + momentumScore) / 300

// ====================== ENTRY/EXIT CALCULATIONS ======================

// Entry Price
entryPrice = close

// Take Profit Levels
tp1 = entryPrice * (1 + tp_Percent / 100)
tp2 = entryPrice * (1 + tp_Percent * 1.5 / 100)

// Stop Loss
sl = entryPrice * (1 - sl_Percent / 100)

// Sell Side TP/SL
tp1Sell = entryPrice * (1 - tp_Percent / 100)
tp2Sell = entryPrice * (1 - tp_Percent * 1.5 / 100)
slSell = entryPrice * (1 + sl_Percent / 100)

// ====================== BUY/SELL SIGNALS ======================

buyCondition = (fvgUp or bosUp or bullDivergence or pinBarUp) and 
               (rsi < rsiOversold + 10) and 
               (stochK < 50) and
               volConfirm and
               aiConfidenceBuy > confidenceMin

sellCondition = (fvgDown or bosDown or bearDivergence or pinBarDown) and 
                (rsi > rsiOverbought - 10) and 
                (stochK > 50) and
                volConfirm and
                aiConfidenceSell > confidenceMin

// ====================== PLOTTING ======================

// Strategy Label
strategyLabel = isScalping ? "⚡ SCALPING" : (isSwing ? "📊 SWING" : "📈 DAILY")
marketLabel = isCrypto ? "🪙 CRYPTO" : (isForex ? "💱 FOREX" : (isGold ? "🥇 GOLD" : (isIndices ? "📊 INDICES" : "📈 STOCKS")))

var label strategyLbl = na
if barstate.islast
    strategyLbl := label.new(bar_index, high * 1.10, strategyLabel + " | " + marketLabel, xloc=xloc.bar_index, yloc=yloc.abovebar, 
                             color=color.new(color.blue, 80), textcolor=color.white, size=size.large, style=label.style_label_down)

// Swing Points
plot(swingHigh ? high[swingLength] : na, "Swing High", color.new(color.red, 0), linewidth=2, style=plot.style_circles)
plot(swingLow ? low[swingLength] : na, "Swing Low", color.new(color.green, 0), linewidth=2, style=plot.style_circles)

// BOS
plotshape(bosUp, title="BOS UP", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BOS↑")
plotshape(bosDown, title="BOS DOWN", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="BOS↓")

// AI Signals
plotshape(buyCondition, title="🤖 AI BUY", style=shape.triangleup, location=location.belowbar, 
          color=color.new(color.green, 0), size=size.large, text="BUY", textcolor=color.white)

plotshape(sellCondition, title="🤖 AI SELL", style=shape.triangledown, location=location.abovebar, 
          color=color.new(color.red, 0), size=size.large, text="SELL", textcolor=color.white)

// Entry & Exit Levels for Buy
plot(buyCondition ? entryPrice : na, "Entry", color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)
plot(buyCondition ? tp1 : na, "TP1", color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(buyCondition ? tp2 : na, "TP2", color.new(color.lightgreen, 0), linewidth=2, style=plot.style_linebr)
plot(buyCondition ? sl : na, "SL", color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Entry & Exit Levels for Sell
plot(sellCondition ? entryPrice : na, "Sell Entry", color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
plot(sellCondition ? tp1Sell : na, "TP1 Sell", color.new(color.maroon, 0), linewidth=2, style=plot.style_linebr)
plot(sellCondition ? tp2Sell : na, "TP2 Sell", color.new(color.burgundy, 0), linewidth=2, style=plot.style_linebr)
plot(sellCondition ? slSell : na, "SL Sell", color.new(color.darkred, 0), linewidth=2, style=plot.style_linebr)

// Bar Color
barcolor(buyCondition ? color.new(color.green, 30) : (sellCondition ? color.new(color.red, 30) : na))

// ====================== INFO TABLE ======================

var table infoTable = table.new(position=position.top_right, columns=2, rows=10, 
                                border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, strategyLabel + " | " + marketLabel, bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, currentTimeframe, bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 1, "AI BUY %", bgcolor=color.new(color.green, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(math.round(aiConfidenceBuy * 100, 2)), bgcolor=color.new(color.green, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "AI SELL %", bgcolor=color.new(color.red, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(math.round(aiConfidenceSell * 100, 2)), bgcolor=color.new(color.red, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "RSI", bgcolor=color.new(color.teal, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(math.round(rsi, 2)), bgcolor=color.new(color.teal, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 4, "Stoch %K", bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(math.round(stochK, 2)), bgcolor=color.new(color.purple, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 5, "TP Ratio %", bgcolor=color.new(color.navy, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(math.round(tp_Percent, 2)), bgcolor=color.new(color.navy, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 6, "SL Ratio %", bgcolor=color.new(color.maroon, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(math.round(sl_Percent, 2)), bgcolor=color.new(color.maroon, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 7, "R:R Ratio", bgcolor=color.new(color.olive, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(math.round(tp_Percent / sl_Percent, 2)) + ":1", bgcolor=color.new(color.olive, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 8, "Volume", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, volConfirm ? "HIGH ✓" : "LOW", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 9, "Trend", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 9, (trendScore > 50 ? "UP 📈" : "DOWN 📉"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)

// ====================== ALERTS ======================

alertcondition(buyCondition, title="🤖 " + strategyLabel + " BUY SIGNAL", 
               message="🤖 BUY SIGNAL! Strategy: " + strategyLabel + " | Market: " + marketLabel + " | Confidence: " + str.tostring(math.round(aiConfidenceBuy * 100, 2)) + "% | Entry: " + str.tostring(math.round(entryPrice, 4)) + " | TP1: " + str.tostring(math.round(tp1, 4)) + " | SL: " + str.tostring(math.round(sl, 4)))

alertcondition(sellCondition, title="🤖 " + strategyLabel + " SELL SIGNAL", 
               message="🤖 SELL SIGNAL! Strategy: " + strategyLabel + " | Market: " + marketLabel + " | Confidence: " + str.tostring(math.round(aiConfidenceSell * 100, 2)) + "% | Entry: " + str.tostring(math.round(entryPrice, 4)) + " | TP1: " + str.tostring(math.round(tp1Sell, 4)) + " | SL: " + str.tostring(math.round(slSell, 4)))
